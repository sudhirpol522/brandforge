# Core
BRANDFORGE_ENV=development
BRANDFORGE_LOG_LEVEL=INFO
BRANDFORGE_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
BRANDFORGE_DEV_AUTH=true
BRANDFORGE_DEFAULT_TENANT=demo-studio
BRANDFORGE_DEFAULT_USER=creative-director

# Persistence: use SQLite for the zero-configuration demo. Docker Compose overrides this.
DATABASE_URL=sqlite:///./data/brandforge.db
OBJECT_STORE_PROVIDER=local
LOCAL_OBJECT_STORE_PATH=./data/objects

# S3 / MinIO
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=brandforge-assets
S3_ACCESS_KEY_ID=brandforge
S3_SECRET_ACCESS_KEY=change-me-for-local-only
S3_REGION=us-east-1

# Model routing. Use "deterministic" only for tests or the offline demo.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6
OPENAI_VISION_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_BASE_URL=
OPENAI_REASONING_EFFORT=none
OPENAI_TEXT_MAX_OUTPUT_TOKENS=1024
OPENAI_VISION_MAX_OUTPUT_TOKENS=1024
# Estimated per-call amounts drive BrandForge's local budget guard; tune to your usage.
OPENAI_ESTIMATED_TEXT_CALL_USD=0.01
OPENAI_ESTIMATED_VISION_CALL_USD=0.015
OPENAI_ESTIMATED_IMAGE_CALL_USD=0.05
MODEL_REQUEST_BUDGET_USD=5.00
MODEL_MAX_CALLS_PER_CAMPAIGN=50

# Multimodal retrieval. Deterministic is only for local smoke tests.
RETRIEVAL_ENABLED=true
RETRIEVAL_EMBEDDING_PROVIDER=deterministic
RETRIEVAL_MODEL_NAME=ViT-B-32
RETRIEVAL_MODEL_VERSION=laion2b_s34b_b79k
RETRIEVAL_EMBEDDING_DIMENSION=32
RETRIEVAL_DEVICE=cpu
RETRIEVAL_CANDIDATE_LIMIT=50
# Production API processes can use the isolated multimodal service instead of loading Torch.
RETRIEVAL_REMOTE_URL=
RETRIEVAL_WORKER_TOKEN=
RETRIEVAL_TENANTS=demo-studio

# Load only a reviewed, versioned Bradley-Terry artifact.
PREFERENCE_MODEL_PATH=

# Adobe Firefly server-side integration
ADOBE_FIREFLY_ENABLED=false
ADOBE_FIREFLY_CLIENT_ID=
ADOBE_FIREFLY_CLIENT_SECRET=
ADOBE_FIREFLY_BASE_URL=https://firefly-api.adobe.io
ADOBE_IMS_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3

# Adobe Express Embed SDK (browser-visible client ID; configure allowed domains)
NEXT_PUBLIC_ADOBE_EXPRESS_ENABLED=false
NEXT_PUBLIC_ADOBE_EXPRESS_CLIENT_ID=
NEXT_PUBLIC_ADOBE_EXPRESS_APP_NAME=BrandForge

# Optional durable orchestration
ORCHESTRATOR=inline
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=brandforge-general

# Keep traces disabled unless the Compose observability profile is running.
OTEL_SDK_DISABLED=true

# Security and limits
MAX_UPLOAD_BYTES=26214400
SIGNED_URL_TTL_SECONDS=900
ALLOWED_ORIGINS=http://localhost:3000
